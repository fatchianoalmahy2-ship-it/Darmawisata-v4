        "busNumber": { "type": "number" },
        "major": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "settings": {
      "title": "Settings",
      "description": "Konfigurasi global darmawisata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
